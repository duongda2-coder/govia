<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="com.govia.workflow">

    <!--
      Phe duyet "Kiến nghị" gan cho 1 dong TTSS (Khối C, sheet "Quản lý công việc" trong
      Tạo CKT (1).xlsx, chuc nang "5. Phê duyệt kiến nghị") - rap khuon y het
      audit-workitem-approval.bpmn20.xml. Chi khac ten process/bien businessKey va listener dich.

      Bien vao (do AuditTtssService thiet lap luc start):
        - ttssRecordId (bat buoc)  : id cua AuditTtssRecord dang cho duyet kien nghi
        - approverChain (bat buoc) : List<String> UserAccount.id theo dung thu tu duyet
        - approved (mac dinh true luc start)
    -->
    <process id="audit_recommendation_approval" name="Audit Recommendation Approval" isExecutable="true">

        <startEvent id="start" />

        <userTask id="chainApprovalTask" name="Duyệt kiến nghị" flowable:assignee="${currentApproverId}">
            <extensionElements>
                <flowable:taskListener event="create" delegateExpression="${workflowTaskCreatedNotifier}" />
            </extensionElements>
            <multiInstanceLoopCharacteristics isSequential="true"
                                               flowable:collection="${approverChain}"
                                               flowable:elementVariable="currentApproverId">
                <completionCondition>${approved == false}</completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <exclusiveGateway id="chainOutcomeGateway" name="Dây duyệt: đạt?" />

        <endEvent id="endApproved" name="Approved">
            <extensionElements>
                <flowable:executionListener event="end" delegateExpression="${auditRecommendationApprovalApprovedListener}" />
            </extensionElements>
        </endEvent>
        <endEvent id="endRejected" name="Rejected">
            <extensionElements>
                <flowable:executionListener event="end" delegateExpression="${auditRecommendationApprovalRejectedListener}" />
            </extensionElements>
        </endEvent>

        <sequenceFlow sourceRef="start" targetRef="chainApprovalTask" />
        <sequenceFlow sourceRef="chainApprovalTask" targetRef="chainOutcomeGateway" />

        <sequenceFlow sourceRef="chainOutcomeGateway" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == true}]]></conditionExpression>
        </sequenceFlow>
        <sequenceFlow sourceRef="chainOutcomeGateway" targetRef="endRejected">
            <conditionExpression xsi:type="tFormalExpression"><![CDATA[${approved == false}]]></conditionExpression>
        </sequenceFlow>

    </process>
</definitions>
